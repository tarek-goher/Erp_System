APP_NAME="CodeSphere ERP"
APP_ENV=local
APP_KEY=base64:AdDCpOFsinPcAZ76wRRUTrojPP0sxGt+V+M2ZquOqzo=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ══════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codesphere_erp
DB_USERNAME=root
DB_PASSWORD=

# ══════════════════════════════════════════
# SANCTUM & CORS - مهم جداً للـ Next.js
# ══════════════════════════════════════════
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ══════════════════════════════════════════
# SESSION - لازم cookie مش database
# ══════════════════════════════════════════
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ══════════════════════════════════════════
# CACHE & QUEUE
# ══════════════════════════════════════════
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ══════════════════════════════════════════
# MAIL
# ══════════════════════════════════════════
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@codesphere.io"
MAIL_FROM_NAME="${APP_NAME}"

# ══════════════════════════════════════════
# AWS (اختياري)
# ══════════════════════════════════════════
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"